<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hust.soict.dsai.aims.screen.addItem.AddItemToStoreScreen">
   <center>
      <VBox alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <padding><Insets top="50.0" /></padding>
         <children>
            <Label fx:id="lblHeader" text="Add Item to Store" textFill="AQUA">
               <font><Font size="36.0" /></font>
            </Label>
            <GridPane alignment="CENTER" hgap="10" maxWidth="400" vgap="15">
               <children>
                  <Label text="Title:" GridPane.rowIndex="0" />
                  <TextField fx:id="tfTitle" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Category:" GridPane.rowIndex="1" />
                  <TextField fx:id="tfCategory" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Cost:" GridPane.rowIndex="2" />
                  <TextField fx:id="tfCost" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label fx:id="lblExtra" text="Info:" GridPane.rowIndex="3" />
                  <TextField fx:id="tfExtra" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#btnAddPressed" text="Add to Store" />
         </children>
      </VBox>
   </center>
</BorderPane>